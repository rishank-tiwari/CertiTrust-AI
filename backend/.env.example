# MongoDB Atlas Connection URL
MONGODB_URL=

# MongoDB Database Name
DATABASE_NAME=certitrust

# JWT Secret Authentication Key (highly secure random string)
JWT_SECRET_KEY=

# Cryptographic algorithm for JWT sign token validation
JWT_ALGORITHM=HS256

# JWT Authentication token expiry time (hours)
JWT_EXPIRY_HOURS=24

# Files local temporary directory location (fallback storage)
UPLOAD_DIR=./uploads

# Max allowed files payload size (MB)
MAX_FILE_SIZE_MB=10

# CORS Allowed Origins - JSON Array or Comma-separated strings
ALLOWED_ORIGINS=["https://certitrust-nexora.vercel.app"]
